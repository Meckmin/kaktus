# ── Database ────────────────────────────────────────────────────────────────
# Pooled connection for the app. Raise connection_limit before running the
# concurrency suite or the races serialise through the pool and prove nothing.
DATABASE_URL="postgresql://kaktus:kaktus@localhost:5432/kaktus?schema=public"
# Unpooled connection for migrations (Prisma needs a direct session).
DIRECT_DATABASE_URL="postgresql://kaktus:kaktus@localhost:5432/kaktus?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# Leave empty for local development: sign-in links are printed to the server
# console and appended to .auth-link.txt instead of being emailed. A real key
# starts with "re_". Set AUTH_FORCE_EMAIL=1 to send real mail while developing.
AUTH_RESEND_KEY=""
# Resend's own SDK convention. Either name works — set one, not both.
RESEND_API_KEY=""
AUTH_FORCE_EMAIL=""
# '1' to allow the local sign-in-link-on-disk fallback in production. Leave
# unset — this exists for break-glass debugging, not normal deploys.
AUTH_ALLOW_LOCAL_LINKS=""
# Must be an address on a domain verified in the Resend dashboard. Until a
# domain is verified, use Resend's shared testing sender instead:
#   EMAIL_FROM="Kaktüs Koçluk <onboarding@resend.dev>"
EMAIL_FROM="Kaktüs Koçluk <merhaba@kaktuskocluk.com>"

# ── Payments ────────────────────────────────────────────────────────────────
# "mock" runs the deterministic in-memory provider. Everything above the
# provider interface is identical, so leave this as mock until Phase 4.
PAYMENT_PROVIDER="mock"
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# ── Storage (verification documents — private bucket, never public URLs) ────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public IP reported to Iyzico on refund calls (they require an `ip` field).
SERVER_PUBLIC_IP="127.0.0.1"
# Where Iyzico redirects the browser after the hosted checkout form.
APP_URL="http://localhost:3000"

# ── Field encryption (coach payout details: IBAN, TCKN/VKN) ─────────────────
# Plaintext-key path — fine for local dev, not for production with real payout
# volume. Mutually exclusive with the KMS vars below; if both are set, KMS wins.
# openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""

# KMS-wrapped path (production). Generate with, after creating a symmetric KMS
# key in the AWS console:
#   node scripts/kms-generate-key.mjs --key-id alias/your-key-alias
FIELD_ENCRYPTION_KMS_CIPHERTEXT=""
AWS_REGION=""
AWS_KMS_KEY_ID=""
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — not listed here because the AWS
# SDK reads them (and the IAM instance-role chain) on its own; only set them
# explicitly if not deploying somewhere with an attached IAM role.

# Private bucket for verification documents. Falls back to ./.uploads locally.
DOCUMENT_STORAGE_BUCKET="coach-documents"

# ── Background jobs ───────────────────────────────────────────────────────
# openssl rand -base64 32
# Bearer token the scheduler must send to POST /api/cron/jobs. Required in
# production; leave empty in dev to hit the route unauthenticated.
CRON_SECRET=""
