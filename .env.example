# ── Database ────────────────────────────────────────────────────────────────
# Pooled connection for the app. Raise connection_limit before running the
# concurrency suite or the races serialise through the pool and prove nothing.
DATABASE_URL="postgresql://kaktus:kaktus@localhost:5432/kaktus?schema=public"
# Unpooled connection for migrations (Prisma needs a direct session).
DIRECT_DATABASE_URL="postgresql://kaktus:kaktus@localhost:5432/kaktus?schema=public"

# ── Auth.js ─────────────────────────────────────────────────────────────────
# openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""
# ── Email (sign-in links + notifications) — see lib/mail-config.ts ─────────
# With nothing configured, sign-in links are printed to the server console and
# appended to .auth-link.txt. In development that is also the default when a
# provider IS configured; set AUTH_FORCE_EMAIL=1 to send real mail from dev.
# Seed/test addresses (@test.kaktus.dev, *.test, example.com) always stay local
# outside production.
AUTH_FORCE_EMAIL=""
# Resend, once the domain is verified in the Resend dashboard (SPF,
# DKIM). A real key starts with "re_". Resend's shared onboarding@resend.dev
# sender only delivers to the Resend account's own address.
AUTH_RESEND_KEY=""
# Resend's own SDK convention. Either name works — set one, not both.
RESEND_API_KEY=""
EMAIL_FROM="Kaktüs Koçluk <merhaba@kaktuskocluk.com>"

# '1' to allow the local sign-in-link-on-disk fallback in production. Leave
# unset — this exists for break-glass debugging, not normal deploys.
AUTH_ALLOW_LOCAL_LINKS=""

# ── Payments ────────────────────────────────────────────────────────────────
# "mock" runs the deterministic in-memory provider. Everything above the
# provider interface is identical, so leave this as mock until Phase 4.
# In production "mock" refuses to run (it would mark offers paid without
# charging anyone) unless ALLOW_MOCK_PAYMENTS=1 is set for a demo deploy.
PAYMENT_PROVIDER="mock"
ALLOW_MOCK_PAYMENTS=""
IYZICO_API_KEY=""
IYZICO_SECRET_KEY=""
IYZICO_BASE_URL="https://sandbox-api.iyzipay.com"

# ── Storage (verification documents — private bucket, never public URLs) ────
SUPABASE_URL=""
SUPABASE_SERVICE_ROLE_KEY=""

# Public IP reported to Iyzico on refund calls (they require an `ip` field).
SERVER_PUBLIC_IP="127.0.0.1"
# Where Iyzico redirects the browser after the hosted checkout form.
APP_URL="http://localhost:3000"

# ── Field encryption (coach payout details: IBAN, TCKN/VKN) ─────────────────
# Plaintext-key path — fine for local dev, not for production with real payout
# volume. Mutually exclusive with the KMS vars below; if both are set, KMS wins.
# openssl rand -base64 32
FIELD_ENCRYPTION_KEY=""

# KMS-wrapped path (production). Generate with, after creating a symmetric KMS
# key in the AWS console:
#   node scripts/kms-generate-key.mjs --key-id alias/your-key-alias
FIELD_ENCRYPTION_KMS_CIPHERTEXT=""
AWS_REGION=""
AWS_KMS_KEY_ID=""
# AWS_ACCESS_KEY_ID / AWS_SECRET_ACCESS_KEY — not listed here because the AWS
# SDK reads them (and the IAM instance-role chain) on its own; only set them
# explicitly if not deploying somewhere with an attached IAM role.

# Private Supabase Storage bucket for verification documents (create it as
# PRIVATE). Unset SUPABASE_URL locally and documents go to ./.private-uploads.
SUPABASE_VERIFICATION_BUCKET="verification"

# ── Background jobs ───────────────────────────────────────────────────────
# openssl rand -base64 32
# Bearer token the scheduler must send to POST /api/cron/jobs. Required in
# production; leave empty in dev to hit the route unauthenticated.
CRON_SECRET=""

# ── In-app video meetings (daily.co) ─────────────────────────────────────
# dashboard.daily.co → Developers → API key. Without it, "Görüşmeye gir" falls
# back to the coach's own Zoom/Meet link. 10,000 free participant-minutes/month.
DAILY_API_KEY=""

# ── Shared rate limiting (required in production) ─────────────────────────
# Serverless instances don't share memory. Vercel Marketplace → Upstash, or
# console.upstash.com → Redis → REST API. Leave empty locally.
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ── Legal identity (required in production) ───────────────────────────────
# Shown in the footer and legal texts, as 6563 requires. From the vergi
# levhası once the şahıs şirketi is registered.
COMPANY_TITLE=""        # e.g. "Ad Soyad – Kaktüs Koçluk"
COMPANY_ADDRESS=""
COMPANY_TAX_OFFICE=""
COMPANY_TAX_NUMBER=""
COMPANY_MERSIS=""       # optional for a şahıs şirketi
COMPANY_EMAIL=""
COMPANY_PHONE=""        # optional
COMPANY_KEP=""          # optional
ETBIS_URL=""            # ETBİS doğrulama linki, after registering

# '1' only after a lawyer has approved src/content/legal. Until then every
# legal page shows a draft notice and `npm run launch-check` fails.
LEGAL_TEXTS_APPROVED=""
